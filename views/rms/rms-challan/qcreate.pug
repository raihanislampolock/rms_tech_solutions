#createQuotationChallanModal.modal.fade
  .modal-dialog.modal-dialog-centered
    .modal-content

      .modal-header
        h5.modal-title Create Challan From Quotation

      .modal-body

        .form-group
          label Quotation Number

          input.form-control(
            type='text',
            id='searchQuotationId'
          )

      .modal-footer

        button.btn.btn-primary(
          type='button',
          id='loadQuotationForChallan'
        )
          i.fa.fa-search
          |  Load

        button.btn.btn-danger(
          type='button',
          data-dismiss='modal'
        ) Cancel