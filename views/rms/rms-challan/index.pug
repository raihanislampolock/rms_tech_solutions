block script
  script(type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js")
  script(type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js")
  
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const tableBody = document.getElementById('challanTableBody');
      const paginationContainer = document.getElementById('paginationContainer');
      let search = document.getElementById('search');
      const searchBtn = document.getElementById('searchBtn');
      const limitSelect = document.getElementById('limitSelect');
      const dateRangeDisplay = document.querySelector('#date-range-display');
      const dateRangeInput = document.getElementById('date-range-input');

      const updateMargin = () => {
        if (dateRangeDisplay.textContent.trim() === "Select date range") {
          dateRangeDisplay.style.marginRight = "10px";
        } else {
          dateRangeDisplay.style.marginRight = "0";
        }
      };

      updateMargin();

      const observer = new MutationObserver(updateMargin);
      observer.observe(dateRangeDisplay, { childList: true, characterData: true, subtree: true });

      let currentPage = 1;
      let currentSearch = '';
      let limit = limitSelect.value;
      let dateRange = '';
      const selectedRows = new Set();
      const selectedData = [];

      async function fetchChallan(page = 1, search = '', dateRange='', limit = 10) {
        tableBody.innerHTML = `<tr><td colspan="13" class="text-center" style="padding: 3rem;"><i class="fa fa-spinner fa-spin" style="font-size: 32px; color: #580db4;"></i></td></tr>`;
        try {
          const response = await fetch(`/api/rms/rms-challan/all?page=${page}&search=${search}&limit=${limit}`);
          const data = await response.json();

          if (data?.data?.length > 0) {
            const groupedArray = [];
            const groupMap = {};

            data.data.forEach(row => {
              if (!groupMap[row.id]) {
                groupMap[row.id] = {
                  id: row.id,
                  challanNumber: row.challanNumber,
                  companyName: row.companyName,
                  companyEmail: row.companyEmail,
                  challanStatus: row.challanStatus,
                  challanNotes: row.challanNotes,
                  createdBy: row.createdBy,
                  updatedBy: row.updatedBy,
                  created_at: row.created_at,
                  updated_at: row.updated_at,
                  items: []
                };
                groupedArray.push(groupMap[row.id]);
              }

              groupMap[row.id].items.push({
                itemName: row.itemName,
                itemType: row.itemType,
                itemModel: row.itemModel,
                itemConfigurations: row.itemConfigurations,
                deliveredQuantity: row.deliveredQuantity,
                itemNotes: row.itemNotes
              });
            });

            // ===================================
            // ✅ PIPELINE SORTING: NEWEST DATES FIRST
            // ===================================
            groupedArray.sort((a, b) => {
              return new Date(b.created_at) - new Date(a.created_at);
            });

            // ===================================
            // ✅ RENDER ENGINE
            // ===================================
            tableBody.innerHTML = groupedArray.map(c => {
              const totalQty = c.items.reduce((sum, i) => sum + (Number(i.deliveredQuantity) || 0), 0);
              const format = (num) => Number(num || 0).toLocaleString();

              return `
              <tr class="main-row" data-id="${c.id}">
                <td>
                  <a href="#" class="action-icon editChallan" data-challan-id="${c.id}" data-toggle="modal" data-target="#add-edit-challan-modal" title="Edit">
                    <i class="fa fa-edit"></i>
                  </a>
                </td>
                <td>
                  <a href="/api/rms/rms-challan/generate-pdf/${c.id}" class="action-icon pdf-icon" target="_blank" title="Download PDF">
                    <i class="fa fa-download fa-lg"></i>
                  </a>
                </td>
                <td>
                  <a href="/api/rms/rms-challan/view-pdf/${c.id}" class="action-icon pdf-icon" target="_blank" title="View PDF">
                    <i class="fa fa-eye fa-lg"></i>
                  </a>
                </td>
                <td>
                  <a href="#" class="action-icon email-icon sendChallanEmail" data-challan-id="${c.id}" data-company-email="${c.companyEmail}" data-company-name="${c.companyName}" title="Send via Email">
                    <i class="fa fa-envelope"></i>
                  </a>
                </td>

                <td style="font-weight: 600; color: #580db4;">${c.challanNumber ?? '-'}</td>
                <td>${c.companyName ?? '-'}</td>
                <td>${c.companyEmail ?? '-'}</td>
                <td>
                  <span class="badge badge-${c.challanStatus === 'Delivered' ? 'success' : c.challanStatus === 'Pending' ? 'warning' : 'danger'}">
                    ${c.challanStatus ?? 'Pending'}
                  </span>
                </td>
                <td>${c.challanNotes ?? '-'}</td>

                <td>
                  <button class="btn-view-items toggleItems" data-id="${c.id}">
                    <i class="fa fa-list-ul mr-1"></i> View (${c.items.length})
                  </button>
                </td>

                <td>${c.createdBy ?? '-'}</td>
                <td>${c.updatedBy ?? '-'}</td>
                <td>${c.created_at ? new Date(c.created_at).toLocaleDateString() : '-'}</td>
                <td>${c.updated_at ? new Date(c.updated_at).toLocaleDateString() : '-'}</td>
              </tr>

              <tr id="items-${c.id}" style="display:none; background-color: transparent;">
                <td colspan="13" class="child-table-wrapper">
                  <table class="child-table">
                    <thead>
                      <tr>
                        <th>Item Name</th>
                        <th>Type</th>
                        <th>Model</th>
                        <th>Specification</th>
                        <th>Delivered Qty</th>
                        <th>Line Operations Info</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${c.items.map(i => `
                        <tr>
                          <td style="font-weight: 500;">${i.itemName ?? '-'}</td>
                          <td>${i.itemType ?? '-'}</td>
                          <td>${i.itemModel ?? '-'}</td>
                          <td>${i.itemConfigurations ?? '-'}</td>
                          <td style="font-weight: 700;">${i.deliveredQuantity ?? '-'}</td>
                          <td>${i.itemNotes ?? '-'}</td>
                        </tr>
                      `).join('')}
                      <tr style="background:#f1f5f9;">
                        <td colspan="4" style="text-align:right; font-weight: 700; color: #2d3748;">MANIFEST PACK TOTAL OUTBOUND:</td>
                        <td style="font-weight: 700; color: #580db4;">${format(totalQty)}</td>
                        <td></td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
              `;
            }).join('');

            selectedRows.forEach((id) => {
              const row = tableBody.querySelector(`[data-id="${id}"]`);
              if (row) row.classList.add('selected-row');
            });

            const totalRecords = data.total;
            const startRecord = (currentPage - 1) * limit + 1;
            const endRecord = Math.min(currentPage * limit, totalRecords);

            document.querySelector('#title-filter').textContent = `Showing ${startRecord} to ${endRecord} of ${totalRecords} entries`;

          } else {
            tableBody.innerHTML = `<tr><td colspan="13" class="text-center" style="padding: 3rem; color: #a0aec0;">No matching challans found.</td></tr>`;
            document.querySelector('#title-filter').textContent = 'No entries to display';
            return;
          }

          const totalPages = Math.ceil(data.total / limit);
          renderPagination(totalPages, page);

        } catch (error) {
          console.error('Error fetching challans:', error);
          tableBody.innerHTML = `<tr><td colspan="13" class="text-center" style="padding: 3rem; color: #e53e3e;">Error loading data. Please try again.</td></tr>`;
          document.querySelector('#title-filter').textContent = 'Error loading entries';
        }
      }

      function renderPagination(totalPages, currentPage) {
        paginationContainer.innerHTML = ""
        if (!totalPages || totalPages <= 0) return;

        const maxVisiblePages = 5

        const createPageLink = (page, isActive = false) => {
          const pageItem = document.createElement("li")
          if (isActive) pageItem.classList.add("active")
          pageItem.innerHTML = `<a href="#" class="pagination-link" data-page="${page}">${page}</a>`
          paginationContainer.appendChild(pageItem)
        }

        if (currentPage > 1) {
          const prevItem = document.createElement("li")
          prevItem.innerHTML = `<a href="#" class="pagination-link" data-page="${currentPage - 1}"><i class="fa fa-chevron-left" style="font-size: 0.8em; pointer-events:none;"></i></a>`
          paginationContainer.appendChild(prevItem)
        }

        if (totalPages <= maxVisiblePages) {
          for (let i = 1; i <= totalPages; i++) {
            createPageLink(i, i === currentPage)
          }
        } else {
          createPageLink(1, currentPage === 1)
          let rangeStart = Math.max(2, currentPage - Math.floor(maxVisiblePages / 2))
          const rangeEnd = Math.min(totalPages - 1, rangeStart + maxVisiblePages - 3)

          if (rangeEnd === totalPages - 1) {
            rangeStart = Math.max(2, rangeEnd - maxVisiblePages + 3)
          }

          if (rangeStart > 2) {
            paginationContainer.innerHTML += `<li><span style="pointer-events:none;">...</span></li>`
          }

          for (let i = rangeStart; i <= rangeEnd; i++) {
            createPageLink(i, i === currentPage)
          }

          if (rangeEnd < totalPages - 1) {
            paginationContainer.innerHTML += `<li><span style="pointer-events:none;">...</span></li>`
          }

          if (totalPages > 1) {
            createPageLink(totalPages, currentPage === totalPages)
          }
        }

        if (currentPage < totalPages) {
          const nextItem = document.createElement("li")
          nextItem.innerHTML = `<a href="#" class="pagination-link" data-page="${currentPage + 1}"><i class="fa fa-chevron-right" style="font-size: 0.8em; pointer-events:none;"></i></a>`
          paginationContainer.appendChild(nextItem)
        }
      }

      function updatePage(page) {
        let currentSearch = search.value;
        dateRange = dateRangeInput.value;
        currentPage = page;
        fetchChallan(currentPage, currentSearch, dateRange, limit);
      }

      paginationContainer.addEventListener('click', function(event) {
        if (event.target.classList.contains('pagination-link')) {
          event.preventDefault();
          const page = parseInt(event.target.getAttribute('data-page'), 10);
          if (!isNaN(page)) {
            updatePage(page);
          }
        }
      });

      search.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchBtn.click();
        }
      });

      searchBtn.addEventListener('click', () => {
        selectedRows.clear();
        selectedData.length = 0;
        currentSearch = search.value;
        dateRange = dateRangeInput.value;
        fetchChallan(1, currentSearch, dateRange, limit);
      });
      
      limitSelect.addEventListener('change', () => {
        limit = limitSelect.value;
        currentSearch = search.value;
        dateRange = dateRangeInput.value;
        currentPage = 1;
        fetchChallan(currentPage, currentSearch, dateRange, limit);
      });

      tableBody.addEventListener('click', function(event) {
        const btn = event.target.closest('.toggleItems');
        if (!btn) return;
        event.preventDefault();

        const id = btn.dataset.id;
        const itemsRow = document.getElementById(`items-${id}`);
        if (!itemsRow) return;

        itemsRow.style.display = itemsRow.style.display === 'none' || itemsRow.style.display === '' ? 'table-row' : 'none';
      });

      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(today.getDate() - 1);
      
      $('#daterange-btn').daterangepicker({
        startDate: yesterday,
        endDate: today,
        ranges: {
          'Today': [moment(), moment()],
          'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
          'Last 7 Days': [moment().subtract(6, 'days'), moment()],
          'Last 30 Days': [moment().subtract(29, 'days'), moment()],
          'This Month': [moment().startOf('month'), moment().endOf('month')],
          'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
        },
        locale: {
          format: 'MMMM DD, YYYY'
        }
      }, function(start, end, label) {
        const startDate = start.format('MMMM DD, YYYY');
        const endDate = end.format('MMMM DD, YYYY');
        dateRangeDisplay.innerText = `${startDate} - ${endDate}`;
        dateRangeInput.value = `${startDate} - ${endDate}`;
      });

      const initialStart = moment(yesterday).format('MMMM DD, YYYY');
      const initialEnd = moment(today).format('MMMM DD, YYYY');
      dateRangeDisplay.innerText = `${initialStart} - ${initialEnd}`;
      dateRangeInput.value = `${initialStart} - ${initialEnd}`;

      $('.btn-download').on('click', function () {
        const dateRangeDisplay = document.querySelector('#date-range-display');
        const $downloadBtn = $(".btn-download");
        const originalText = $downloadBtn.html();
        let dateRange = dateRangeDisplay.textContent.trim();

        if (!dateRange) {
            swal("Warning", "No date range selected!", "warning");
            return;
        }

        $downloadBtn.prop("disabled", true).html(`<i class="fas fa-spinner fa-spin"></i> Downloading...`);

        $.ajax({
          url: `/api/callcenter/service-status/export-excel?`,
          method: "GET",
          xhrFields: { responseType: "blob" },
          success: function (blob, status, xhr) {
              const contentDisposition = xhr.getResponseHeader("Content-Disposition");
              let filename = "X_Ray_Tracker.xlsx";
              if (contentDisposition) {
                  const match = contentDisposition.match(/filename="(.+)"/);
                  if (match && match.length > 1) {
                      filename = match[1];
                  }
              }

              const blobUrl = window.URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = blobUrl;
              a.download = filename;
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(blobUrl);
              document.body.removeChild(a);
          },
          error: function (xhr, status, err) {
              swal("Error", "Failed to download. Please try again.", "error");
          },
          complete: function () {
              $downloadBtn.prop("disabled", false).html(originalText);
          }
        });
      });      

      fetchChallan(currentPage, currentSearch, dateRangeInput.value, limit);
    });

    document.addEventListener('DOMContentLoaded', function () {

        // ========================
        // STATE
        // ========================
        let cart = [];
        let editMode = false;
        let editId = null;
    
        // ========================
        // ELEMENTS
        // ========================
        const itemSelect = document.getElementById('itemSelect');
        const deliveredQuantity = document.getElementById('deliveredQuantity');
        const itemStock = document.getElementById('itemStock');
    
        const challanNumber = document.getElementById('challanNumber');
        const quotationId = document.getElementById('quotationId');
        const companyEmail = document.getElementById('companyEmail');
        const challanStatus = document.getElementById('challanStatus');
        const notes = document.getElementById('notes');


        // ========================
        // 📧 SEND EMAIL WITH PDF
        // ========================
        document.addEventListener('click', function (e) {
          // 1. Safely locate the anchor button, even if they click the inner <i> icon
          const emailBtn = e.target.closest('.sendChallanEmail');
          if (!emailBtn) return;
        
          e.preventDefault();
        
          // 2. Read attributes from the BUTTON/ANCHOR element, not the inner icon
          const id = Number(emailBtn.getAttribute('data-challan-id'));
          const email = emailBtn.getAttribute('data-company-email');
          const companyName = emailBtn.getAttribute('data-company-name');
        
          if (!id || !email) {
              swal("Error", "Email not found for this challan", "error");
              return;
          }
        
          // Confirm before sending
          swal({
              title: "Send Challan?",
              text: `Send challan to ${email}?`,
              icon: "question",
              buttons: {
                  cancel: "Cancel",
                  confirm: {
                      text: "Send",
                      value: true
                  }
              }
          }).then((willSend) => {
              if (!willSend) return;
        
              // Gracefully switch the class of the inner icon to a loading spinner
              const iconEl = emailBtn.querySelector('i');
              const originalIconClass = iconEl ? iconEl.className : 'fa fa-envelope';
              
              if (iconEl) {
                  iconEl.className = 'fa fa-spinner fa-spin';
              }
              emailBtn.style.pointerEvents = 'none';
              emailBtn.style.cursor = 'not-allowed';
        
              // Send email via API
              fetch(`/api/rms/rms-challan/send-email/${id}`, {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json'
                  }
              })
              .then(response => response.json())
              .then(data => {
                  if (iconEl) iconEl.className = originalIconClass;
                  emailBtn.style.pointerEvents = 'auto';
                  emailBtn.style.cursor = 'pointer';
        
                  if (data.status) {
                      swal("Success", data.message, "success");
                  } else {
                      swal("Error", data.message || 'Failed to send email', "error");
                  }
              })
              .catch(error => {
                  if (iconEl) iconEl.className = originalIconClass;
                  emailBtn.style.pointerEvents = 'auto';
                  emailBtn.style.cursor = 'pointer';
                  console.error('Error:', error);
                  swal("Error", 'Error sending email: ' + error.message, "error");
              });
          });
        });
    
        const modal = $('#add-edit-challan-modal');
    
        // ========================
        // RESET FORM
        // ========================
        function resetForm() {
            cart = [];
            editMode = false;
            editId = null;
    
            challanNumber.value = '';
            quotationId.value = '';
            deliveredQuantity.value = '';
            itemStock.value = '';
    
            renderCart();
        }
    
        // ========================
        // SHOW STOCK ON SELECT
        // ========================
        itemSelect?.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            itemStock.value = opt.dataset.stock || 0;
        });
    
        // ========================
        // MODAL OPEN → AUTO GENERATE CHALLAN NUMBER
        // ========================
        modal.on('shown.bs.modal', async function () {
        
            if (!editMode) {
                resetForm();
    
                challanNumber.value = "Generating...";
    
                try {
                    const res = await fetch(`/api/rms/rms-challan/generate-ref?companyName=TEMP`);
                    const data = await res.json();
    
                    if (data?.status && data?.challanNumber) {
                        challanNumber.value = data.challanNumber;
                    } else {
                        challanNumber.value = '';
                    }
    
                } catch (err) {
                    console.error("REF ERROR:", err);
                    challanNumber.value = '';
                }
            }
        });
    
        // ========================
        // ADD ITEM
        // ========================
        document.getElementById('addItem')?.addEventListener('click', function () {
        
            const opt = itemSelect.options[itemSelect.selectedIndex];
            const itemId = itemSelect.value;
    
            const stock = Number(opt.dataset.stock || 0);
            const qty = Number(deliveredQuantity.value);
    
            if (!itemId) return swal("Warning", "Select item", "warning");
            if (!qty || qty <= 0) return swal("Warning", "Enter quantity", "warning");
            if (qty > stock) return swal("Warning", "Quantity exceeds stock", "warning");
            if (cart.find(x => x.itemId == itemId)) return swal("Warning", "Already added", "warning");
    
            cart.push({
                itemId,
                itemName: opt.dataset.name || opt.text,
                availableStock: stock,
                deliveredQuantity: qty,
                notes: ''
            });
    
            renderCart();
    
            itemSelect.value = '';
            deliveredQuantity.value = '';
            itemStock.value = '';
        });
    
        // ========================
        // REMOVE ITEM
        // ========================
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.removeItem');
            if (!btn) return;
    
            cart.splice(btn.dataset.index, 1);
            renderCart();
        });
    
        // ========================
        // UPDATE NOTES
        // ========================
        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('noteInput')) return;
    
            const index = e.target.dataset.index;
            if (cart[index]) {
                cart[index].notes = e.target.value;
            }
        });
    
        // ========================
        // RENDER TABLE
        // ========================
        function renderCart() {
            const tbody = document.querySelector('#itemTable tbody');
            tbody.innerHTML = '';
    
            if (!cart.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center">No item added yet.</td>
                    </tr>
                `;
                return;
            }
    
            cart.forEach((item, i) => {
                tbody.innerHTML += `
                    <tr>
                        <td>${item.itemName}</td>
                        <td>${item.availableStock}</td>
                        <td>${item.deliveredQuantity}</td>
                        <td>
                            <input type="text"
                                   class="form-control noteInput"
                                   data-index="${i}"
                                   value="${item.notes || ''}"
                                   placeholder="Optional note">
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm removeItem" data-index="${i}">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
        }
    
        // ========================
        // LOAD EDIT
        // ========================
        async function loadChallan(id) {
            try {
                const res = await fetch(`/api/rms/rms-challan/edit/${id}`);
                const result = await res.json();
    
                if (!result.status) return;
    
                const c = result.data;
    
                editMode = true;
                editId = id;
    
                challanNumber.value = c.challanNumber || '';
                companyName.value = c.companyName || '';
                companyEmail.value = c.companyEmail || '';
                challanStatus.value = c.challanStatus || '';
                notes.value = c.notes || '';
    
                cart = (c.items || []).map(i => ({
                    itemId: i.itemId,
                    itemName: i.itemName,
                    availableStock: Number(i.availableStock || 0),
                    deliveredQuantity: Number(i.deliveredQuantity),
                    notes: i.notes || ''
                }));
    
                renderCart();
    
            } catch (err) {
                console.error(err);
            }
        }
    
        // ========================
        // SAVE
        // ========================
        document.getElementById('saveChallan')?.addEventListener('click', async function () {
        
            if (!cart.length) return swal("Warning", "No items added", "warning");
    
            const payload = {
                challanNumber: challanNumber.value,
                quotationId: Number(quotationId.value) || undefined,
                companyName: companyName.value,
                companyEmail: companyEmail.value,
                challanStatus: challanStatus.value,
                notes: notes.value,
                items: cart
            };
    
            let url = `/api/rms/rms-challan/create`;
            let method = 'POST';
    
            if (editMode) {
                url = `/api/rms/rms-challan/update/${editId}`;
                method = 'PUT';
            }
    
            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
    
                const result = await res.json();
    
                if (result.status) {
                    swal("Success", result.message, "success")
                        .then(() => window.location.reload());
                } else {
                    swal("Error", result.message, "error");
                }
    
            } catch (err) {
                console.error(err);
                swal("Error", "Request failed", "error");
            }
        });
        // ========================
        // CLICK EDIT BUTTON
        // ========================
        document.addEventListener('click', async function (e) {
        
            const btn = e.target.closest('.editChallan');
            if (!btn) return;

            e.preventDefault();

            const id = btn.dataset.challanId;

            if (!id) {
                swal("Error", "Invalid Challan ID", "error");
                return;
            }

            await loadChallan(id);

            $('#add-edit-challan-modal').modal('show');
        });

        // ========================
        // LOAD QUOTATION → CHALLAN

        document.getElementById('loadQuotationForChallan')
        ?.addEventListener('click', async function () {
        
            const refNumber =
                document.getElementById('searchQuotationId').value;

            if (!refNumber) {
                return swal("Warning", "Enter quotation number", "warning");
            }

            try {
            
                const res = await fetch(
                    `/api/rms/rms-challan/load-from-quotation/${encodeURIComponent(refNumber)}`
                );

                const result = await res.json();

                console.log(result);

                if (!result.status) {
                    return swal("Error", result.message, "error");
                }

                const quotation = result.data;

                // ========================
                // RESET
                // ========================

                resetForm();

                editMode = true;
                editId = null;

                // ========================
                // BASIC INFO
                // ========================

                quotationId.value = quotation.quotationId || '';
                companyName.value = quotation.companyName || '';
                companyEmail.value = quotation.companyEmail || '';
                challanStatus.value = 'pending';
                challanNumber.value = quotation.challanNumber || '';

                // ========================
                // LOAD ITEMS INTO CART
                // ========================

                cart = (quotation.items || []).map(item => ({
                    itemId: item.itemId,
                    itemName: item.itemName,
                    availableStock: Number(item.availableStock || 0),
                    deliveredQuantity: Number(item.deliveredQuantity || 0),
                    notes: item.notes || ''
                }));

                // ========================
                // RENDER
                // ========================

                renderCart();

                // ========================
                // CLOSE SEARCH MODAL
                // ========================

                $('#createQuotationChallanModal').modal('hide');

                // ========================
                // OPEN EXISTING MODAL
                // ========================

                $('#add-edit-challan-modal').modal('show');

            } catch (err) {
            
                console.error(err);

                swal("Error", "Failed to load quotation", "error");
            }
        });
    });