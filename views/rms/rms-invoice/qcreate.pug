#createQuotationInvoiceModal.modal.fade
  .modal-dialog.modal-dialog-centered
    .modal-content

      .modal-header
        h5.modal-title Create Invoice From Quotation

      .modal-body

        .form-group
          label Quotation Ref# or ID

          input.form-control(
            type='text',
            id='searchQuotationId',
            placeholder='Enter quotation ref or ID'
          )

      .modal-footer

        button.btn.btn-primary(
          type='button',
          id='loadQuotationForInvoice'
        )
          i.fa.fa-search
          |  Load

        button.btn.btn-danger(
          type='button',
          data-dismiss='modal'
        ) Cancel