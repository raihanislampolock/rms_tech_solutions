#add-edit-invoice-modal.modal.fade(data-backdrop='static', data-keyboard='false')
  .modal-dialog.modal-dialog-centered.modal-xxl(style='max-width: 95%; width: 95%;')
    .modal-content

      form#invoiceForm(role='form', method='POST')

        // ===============================
        // HEADER
        // ===============================
        .modal-header.bg-primary.text-white
          h5.modal-title RMS Invoice
          button.close.text-white(type='button', data-dismiss='modal')
            span &times;

        // ===============================
        // BODY
        // ===============================
        .modal-body.scrollable-area(style='max-height:80vh; overflow-y:auto;')

          // =========================================================
          // INVOICE INFO
          // =========================================================
          .card.shadow-sm.mb-4
            .card-header.bg-light
              h5.mb-0.text-primary Invoice Information

            .card-body
              .row
                .col-md-4
                  .form-group
                    label Invoice Number
                    input.form-control#invoiceNumber(type='text', name='invoiceNumber', readonly)

                    input(type='hidden', id='quotationId', name='quotationId')

                .col-md-4
                  .form-group
                    label Company Name
                    input.form-control#companyName(type='text', name='companyName')

                .col-md-4
                  .form-group
                    label Company Email
                    input.form-control#companyEmail(type='email', name='companyEmail')

              .row
                .col-md-4
                  .form-group
                    label Invoice Status
                    select.form-control#invoiceStatus(name='invoiceStatus')
                      option(value='pending') Pending
                      option(value='paid') Paid
                      option(value='cancelled') Cancelled

                .col-md-8
                  .form-group
                    label Notes
                    textarea.form-control#notes(name='notes', rows='2')

          // =========================================================
          // ITEM SELECTION
          // =========================================================
          .card.shadow-sm.mb-4
            .card-header.bg-light
              h5.mb-0.text-primary Item Selection

            .card-body
              .row

                .col-md-3
                  .form-group
                    label Select Item
                    select.form-control#itemSelect
                      option(value='' selected disabled) Select Item
                      if items && items.length > 0
                        each item in items
                          option(
                            value=item.id,
                            data-name=item.itemName,
                            data-stock=item.availableStock,
                            data-price=item.itemPrice
                          ) #{item.itemName}

                .col-md-2
                  .form-group
                    label Stock
                    input.form-control#itemStock(type='text', readonly)

                .col-md-2
                  .form-group
                    label Qty
                    input.form-control#deliveredQuantity(type='number', min='1', value='1')

                .col-md-2
                  .form-group
                    label Unit Price
                    input.form-control#unitPrice(type='number', min='0', step='0.01')

                .col-md-1
                  .form-group
                    label Disc %
                    input.form-control#itemDiscountPercent(type='number', min='0', step='0.01', value='0')

                .col-md-2
                  .form-group
                    label Item Total
                    input.form-control#itemTotal(type='number', readonly, step='0.01')

              .row.mt-2
                .col-md-12
                  button.btn.btn-primary.float-right#addItem(type='button')
                    i.fa.fa-plus.mr-1
                    | Add Item

          // =========================================================
          // ITEMS TABLE
          // =========================================================
          .card.shadow-sm.mb-4
            .card-header.bg-light
              h5.mb-0.text-primary Added Items

            .card-body
              .table-responsive
                table.table.table-bordered.table-striped#itemTable
                  thead.thead-light
                    tr
                      th Item
                      th.text-center Stock
                      th.text-center Qty
                      th.text-right Unit Price
                      th.text-right Item Disc %
                      th.text-right Item Disc Amt
                      th.text-right Total
                      th Notes
                      th Action

                  tbody
                    tr
                      td.text-center(colspan='9') No item added yet.

          // =========================================================
          // SUMMARY
          // =========================================================
          .card.shadow-sm
            .card-header.bg-light
              h5.mb-0.text-primary Invoice Summary

            .card-body
              .row

                .col-md-3
                  .form-group
                    label Overall Tax %
                    input.form-control#taxAmount(type='number', min='0', step='0.01', value='0')

                .col-md-3
                  .form-group
                    label Overall Discount %
                    input.form-control#discountAmount(type='number', min='0', step='0.01', value='0')

                .col-md-2
                  .form-group
                    label Subtotal
                    input.form-control#subtotal(type='text', readonly, value='0.00')

                .col-md-2
                  .form-group
                    label Tax Value
                    input.form-control#taxValue(type='text', readonly, value='0.00')

                .col-md-2
                  .form-group
                    label Discount Value
                    input.form-control#discountValue(type='text', readonly, value='0.00')

              .row
                .col-md-12
                  .alert.alert-success.text-right.mb-0
                    h4.mb-0
                      | Grand Total:
                      strong.ml-2
                        span#grandTotalDisplay 0.00

                  input(type='hidden', id='grandTotal', name='grandTotal')

        // ===============================
        // FOOTER
        // ===============================
        .modal-footer
          button.btn.btn-success#saveInvoice(type='button')
            i.fa.fa-save.mr-1
            | Save Invoice

          button.btn.btn-secondary(type='button', data-dismiss='modal')
            i.fa.fa-times.mr-1
            | Cancel