extends ../../layout

block style
  link(rel='stylesheet', href='/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css')
  link(rel='stylesheet', href='/plugins/datatables-responsive/css/responsive.bootstrap4.min.css')
  link(rel='stylesheet', href='/plugins/datatables-buttons/css/buttons.bootstrap4.min.css')
  link(rel='stylesheet', href='/plugins/select2/css/select2.min.css')
  link(rel='stylesheet', href='/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css')

block content
  .content-wrapper
    section.content-header
      .container-fluid
        .row.mb-2
          .col-sm-6
            h1 Invoice Management
          .col-sm-6
            ol.breadcrumb.float-sm-right
              li.breadcrumb-item
                a(href='/dashboard') Home
              li.breadcrumb-item.active Invoice Management

    section.content
      .container-fluid
        .row
          .col-12
            .card
              .card-header
                h3.card-title Invoices
                .card-tools
                  a.btn.btn-success.btn-sm(href='/rms/rms-invoice/create')
                    i.fas.fa-plus
                    |  Create Invoice
                  button.btn.btn-primary.btn-sm#createFromQuotationBtn(type='button', data-toggle='modal', data-target='#quotationModal')
                    i.fas.fa-file-import
                    |  Create from Quotation
                  button.btn.btn-info.btn-sm#createFromChallanBtn(type='button', data-toggle='modal', data-target='#challanModal')
                    i.fas.fa-file-invoice
                    |  Create from Challan

              .card-body
                table#invoiceTable.table.table-bordered.table-striped
                  thead
                    tr
                      th Invoice Number
                      th Company Name
                      th Total Amount
                      th Status
                      th Created Date
                      th Actions
                  tbody

        // Edit Modal
        #editModal.modal.fade(tabindex='-1', role='dialog')
          .modal-dialog.modal-lg(role='document')
            .modal-content
              .modal-header
                h4.modal-title Edit Invoice
                button.close(type='button', data-dismiss='modal')
                  span &times;
              form#editInvoiceForm
                input#editId(type='hidden', name='id')
                .modal-body
                  .row
                    .col-md-6
                      .form-group
                        label(for='editInvoiceNumber') Invoice Number *
                        input.form-control#editInvoiceNumber(type='text', name='invoiceNumber', required)
                    .col-md-6
                      .form-group
                        label(for='editCompanyName') Company Name *
                        input.form-control#editCompanyName(type='text', name='companyName', required)
                  .row
                    .col-md-6
                      .form-group
                        label(for='editCompanyEmail') Company Email
                        input.form-control#editCompanyEmail(type='email', name='companyEmail')
                    .col-md-6
                      .form-group
                        label(for='editInvoiceStatus') Status
                        select.form-control#editInvoiceStatus(name='invoiceStatus')
                          option(value='pending') Pending
                          option(value='paid') Paid
                          option(value='cancelled') Cancelled
                  .row
                    .col-md-6
                      .form-group
                        label(for='editTaxAmount') Tax Amount
                        input.form-control#editTaxAmount(type='number', name='taxAmount', step='0.01', min='0')
                    .col-md-6
                      .form-group
                        label(for='editDiscountAmount') Discount Amount
                        input.form-control#editDiscountAmount(type='number', name='discountAmount', step='0.01', min='0')
                  .form-group
                    label(for='editNotes') Notes
                    textarea.form-control#editNotes(name='notes', rows='3')

                  // Items Section
                  .form-group
                    label Items *
                    .table-responsive
                      table.table.table-bordered#editItemsTable
                        thead
                          tr
                            th Item
                            th Quantity
                            th Unit Price
                            th Total Price
                            th Notes
                            th
                        tbody
                .modal-footer
                  button.btn.btn-secondary(type='button', data-dismiss='modal') Close
                  button.btn.btn-primary#editSubmitBtn(type='submit') Update Invoice

        // Quotation Modal
        #quotationModal.modal.fade(tabindex='-1', role='dialog')
          .modal-dialog.modal-lg(role='document')
            .modal-content
              .modal-header
                h4.modal-title Create Invoice from Quotation
                button.close(type='button', data-dismiss='modal')
                  span &times;
              .modal-body
                .form-group
                  label(for='quotationSearch') Search Quotation
                  input.form-control#quotationSearch(type='text', placeholder='Enter quotation number or company name')
                .table-responsive
                  table.table.table-bordered#quotationTable(style='display: none;')
                    thead
                      tr
                        th Quotation Number
                        th Company Name
                        th Date
                        th Actions
                    tbody
              .modal-footer
                button.btn.btn-secondary(type='button', data-dismiss='modal') Close

        // Challan Modal
        #challanModal.modal.fade(tabindex='-1', role='dialog')
          .modal-dialog.modal-lg(role='document')
            .modal-content
              .modal-header
                h4.modal-title Create Invoice from Challan
                button.close(type='button', data-dismiss='modal')
                  span &times;
              .modal-body
                .form-group
                  label(for='challanSearch') Search Challan
                  input.form-control#challanSearch(type='text', placeholder='Enter challan number or company name')
                .table-responsive
                  table.table.table-bordered#challanTable(style='display: none;')
                    thead
                      tr
                        th Challan Number
                        th Company Name
                        th Date
                        th Actions
                    tbody
              .modal-footer
                button.btn.btn-secondary(type='button', data-dismiss='modal') Close

block script
  script.
    // Make items data available to JavaScript
    window.invoiceItems = !{JSON.stringify(items)};
  script(src='/plugins/datatables/jquery.dataTables.min.js')
  script(src='/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js')
  script(src='/plugins/datatables-responsive/js/dataTables.responsive.min.js')
  script(src='/plugins/datatables-responsive/js/responsive.bootstrap4.min.js')
  script(src='/plugins/datatables-buttons/js/dataTables.buttons.min.js')
  script(src='/plugins/datatables-buttons/js/buttons.bootstrap4.min.js')
  script(src='/plugins/select2/js/select2.full.min.js')

  script.
    $(document).ready(function() {
        // Initialize DataTable
        const table = $('#invoiceTable').DataTable({
            ajax: {
                url: '/api/rms/rms-invoice/all',
                type: 'GET'
            },
            columns: [
                { data: 'invoiceNumber' },
                { data: 'companyName' },
                {
                    data: 'totalAmount',
                    render: function(data) {
                        return data ? `$${parseFloat(data).toFixed(2)}` : '$0.00';
                    }
                },
                {
                    data: 'invoiceStatus',
                    render: function(data) {
                        const statusClass = data === 'paid' ? 'success' :
                                          data === 'pending' ? 'warning' : 'danger';
                        return `<span class="badge badge-${statusClass}">${data}</span>`;
                    }
                },
                {
                    data: 'created_at',
                    render: function(data) {
                        return new Date(data).toLocaleDateString();
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        return `
                            <button class="btn btn-sm btn-info edit-btn" data-id="${data}">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-success pdf-btn" data-id="${data}">
                                <i class="fas fa-download"></i> PDF
                            </button>
                            <button class="btn btn-sm btn-danger delete-btn" data-id="${data}">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        `;
                    }
                }
            ],
            responsive: true,
            pageLength: 25
        });

        // Initialize Select2
        $('.item-select').select2({
            theme: 'bootstrap4',
            placeholder: 'Select an item',
            allowClear: true
        });

        // Edit button
        $(document).on('click', '.edit-btn', function() {
            const id = $(this).data('id');

            $.get(`/api/rms/rms-invoice/edit/${id}`)
                .done(function(response) {
                    if (response.status && response.data) {
                        const invoice = response.data;

                        $('#editId').val(invoice.id);
                        $('#editInvoiceNumber').val(invoice.invoiceNumber);
                        $('#editCompanyName').val(invoice.companyName);
                        $('#editCompanyEmail').val(invoice.companyEmail);
                        $('#editInvoiceStatus').val(invoice.invoiceStatus);
                        $('#editTaxAmount').val(invoice.taxAmount || 0);
                        $('#editDiscountAmount').val(invoice.discountAmount || 0);
                        $('#editNotes').val(invoice.notes);

                        // Clear existing items
                        $('#editItemsTable tbody').empty();

                        // Add items
                        invoice.items.forEach(function(item) {
                            const itemOptions = !{JSON.stringify(items)}.map(itemOpt => `<option value="${itemOpt.id}" ${itemOpt.id == (item.itemId || '') ? 'selected' : ''}>${itemOpt.label}</option>`).join('');
                            const rowHtml = `
                                <tr class="item-row">
                                    <td>
                                        <select class="form-control item-select" name="itemId[]" required>
                                            <option value="">Select Item</option>
                                            ${itemOptions}
                                        </select>
                                        <input type="hidden" name="itemName[]" value="${item.itemName}">
                                    </td>
                                    <td>
                                        <input class="form-control quantity-input" type="number" name="quantity[]" min="0" step="1" value="${item.quantity}" required>
                                    </td>
                                    <td>
                                        <input class="form-control unit-price-input" type="number" name="unitPrice[]" min="0" step="0.01" value="${item.unitPrice}" required>
                                    </td>
                                    <td>
                                        <input class="form-control total-price-input" type="number" name="totalPrice[]" min="0" step="0.01" value="${item.totalPrice}" readonly>
                                    </td>
                                    <td>
                                        <input class="form-control notes-input" type="text" name="notes[]" value="${item.notes || ''}" placeholder="Optional notes">
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm remove-item" type="button">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            `;
                            $('#editItemsTable tbody').append(rowHtml);
                        });

                        $('.item-select').select2({
                            theme: 'bootstrap4',
                            placeholder: 'Select an item',
                            allowClear: true
                        });

                        $('#editModal').modal('show');
                    } else {
                        toastr.error('Failed to load invoice data');
                    }
                })
                .fail(function() {
                    toastr.error('Failed to load invoice data');
                });
        });

        // Update invoice
        $('#editInvoiceForm').on('submit', function(e) {
            e.preventDefault();

            const id = $('#editId').val();
            const formData = new FormData(this);
            const data = {
                invoiceNumber: formData.get('invoiceNumber'),
                companyName: formData.get('companyName'),
                companyEmail: formData.get('companyEmail'),
                invoiceStatus: formData.get('invoiceStatus'),
                taxAmount: parseFloat(formData.get('taxAmount') || '0'),
                discountAmount: parseFloat(formData.get('discountAmount') || '0'),
                notes: formData.get('notes'),
                items: []
            };

            // Collect items
            const itemIds = formData.getAll('itemId[]');
            const quantities = formData.getAll('quantity[]');
            const unitPrices = formData.getAll('unitPrice[]');
            const totalPrices = formData.getAll('totalPrice[]');
            const notes = formData.getAll('notes[]');

            for (let i = 0; i < itemIds.length; i++) {
                if (itemIds[i]) {
                    data.items.push({
                        itemId: parseInt(itemIds[i]),
                        quantity: parseInt(quantities[i]) || 0,
                        unitPrice: parseFloat(unitPrices[i]) || 0,
                        totalPrice: parseFloat(totalPrices[i]) || 0,
                        notes: notes[i] || null
                    });
                }
            }

            $.ajax({
                url: `/api/rms/rms-invoice/update/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    if (response.status) {
                        $('#editModal').modal('hide');
                        table.ajax.reload();
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function(xhr) {
                    toastr.error('Failed to update invoice');
                }
            });
        });

        // PDF button
        $(document).on('click', '.pdf-btn', function() {
            const id = $(this).data('id');
            window.open(`/api/rms/rms-invoice/generate-pdf/${id}`, '_blank');
        });

        // Delete button
        $(document).on('click', '.delete-btn', function() {
            const id = $(this).data('id');

            if (confirm('Are you sure you want to delete this invoice?')) {
                $.ajax({
                    url: `/api/rms/rms-invoice/delete/${id}`,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.status) {
                            table.ajax.reload();
                            toastr.success(response.message);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function(xhr) {
                        toastr.error('Failed to delete invoice');
                    }
                });
            }
        });

        // Quotation search
        let quotationSearchTimeout;
        $('#quotationSearch').on('input', function() {
            clearTimeout(quotationSearchTimeout);
            const searchTerm = $(this).val();

            if (searchTerm.length >= 2) {
                quotationSearchTimeout = setTimeout(function() {
                    $.get('/api/rms/rms-quotation/all', { search: searchTerm, limit: 10 })
                        .done(function(response) {
                            if (response.status && response.data.length > 0) {
                                $('#quotationTable tbody').empty();
                                response.data.forEach(function(quotation) {
                                    $('#quotationTable tbody').append(`
                                        <tr>
                                            <td>${quotation.refNumber}</td>
                                            <td>${quotation.companyName}</td>
                                            <td>${new Date(quotation.created_at).toLocaleDateString()}</td>
                                            <td>
                                                <button class="btn btn-sm btn-success create-from-quotation-btn" data-id="${quotation.id}">
                                                    <i class="fas fa-plus"></i> Create Invoice
                                                </button>
                                            </td>
                                        </tr>
                                    `);
                                });
                                $('#quotationTable').show();
                            } else {
                                $('#quotationTable').hide();
                            }
                        });
                }, 500);
            } else {
                $('#quotationTable').hide();
            }
        });

        // Create from quotation
        $(document).on('click', '.create-from-quotation-btn', function() {
            const quotationId = $(this).data('id');

            $.post(`/rms/rms-invoice/create-from-quotation/${quotationId}`)
                .done(function(response) {
                    if (response.status) {
                        $('#quotationModal').modal('hide');
                        table.ajax.reload();
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                })
                .fail(function(xhr) {
                    toastr.error('Failed to create invoice from quotation');
                });
        });

        // Challan search
        let challanSearchTimeout;
        $('#challanSearch').on('input', function() {
            clearTimeout(challanSearchTimeout);
            const searchTerm = $(this).val();

            if (searchTerm.length >= 2) {
                challanSearchTimeout = setTimeout(function() {
                    $.get('/api/rms/rms-challan/all', { search: searchTerm, limit: 10 })
                        .done(function(response) {
                            if (response.status && response.data.length > 0) {
                                $('#challanTable tbody').empty();
                                response.data.forEach(function(challan) {
                                    $('#challanTable tbody').append(`
                                        <tr>
                                            <td>${challan.challanNumber}</td>
                                            <td>${challan.companyName}</td>
                                            <td>${new Date(challan.created_at).toLocaleDateString()}</td>
                                            <td>
                                                <button class="btn btn-sm btn-info create-from-challan-btn" data-id="${challan.id}">
                                                    <i class="fas fa-plus"></i> Create Invoice
                                                </button>
                                            </td>
                                        </tr>
                                    `);
                                });
                                $('#challanTable').show();
                            } else {
                                $('#challanTable').hide();
                            }
                        });
                }, 500);
            } else {
                $('#challanTable').hide();
            }
        });

        // Create from challan
        $(document).on('click', '.create-from-challan-btn', function() {
            const challanId = $(this).data('id');

            $.post(`/rms/rms-invoice/create-from-challan/${challanId}`)
                .done(function(response) {
                    if (response.status) {
                        $('#challanModal').modal('hide');
                        table.ajax.reload();
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                })
                .fail(function(xhr) {
                    toastr.error('Failed to create invoice from challan');
                });
        });
    });