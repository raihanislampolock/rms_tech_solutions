extends ../layout

block style
  style.
    /* Subtle Tech Grid Background */
    section.content {
      background-image: 
        radial-gradient(#3c8dbc1a 1px, transparent 1px), 
        radial-gradient(#3c8dbc1a 1px, transparent 1px);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
      min-height: 100vh;
    }

    .neon-box {
      background: rgba(255, 255, 255, 0.9) !important;
      backdrop-filter: blur(5px); /* Modern Glassmorphism */
      border: 1px solid rgba(0, 0, 0, 0.05);
      border-radius: 12px !important;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease !important;
    }

    .neon-box:hover {
      transform: translateY(-5px) scale(1.01);
      box-shadow: 0 15px 35px rgba(60, 141, 188, 0.2) !important;
    }

    .info-box-icon {
      transition: all 0.4s ease;
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    .neon-box:hover .info-box-icon {
      filter: brightness(1.2);
    }
    
    /* Clean text containment overrides */
    .info-box-content {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

include ../partials/dashboard-selector

block content
  section.content-header
    h1
      | SuperAdmin Dashboard
    ol.breadcrumb
      li
        a(href='/dashboard')
          img(
            src='/dist/img/rms-logo.svg', 
            alt='RMS Logo', 
            style='width: 20px; height: 20px; margin-right: 8px; vertical-align: middle; display: inline-block;'
          )
          | Dashboard

  section.content
    +dashboardSelector(user.roleName)

    .row
      .col-md-12
        .box.box-parrot(style="background: transparent; border: none; box-shadow: none;")
          .box-header(style="padding-bottom: 20px;")
            h3.box-title(style="font-weight: 700; color: #2c3e50; letter-spacing: 1px;") 
              i.fa.fa-rocket(style="margin-right: 10px; color: #3c8dbc;")
              | RMS COMMAND CENTER

    .row
      //- Row 1: Item Modules
      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-items' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/list-logo.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") RMS ITEMS
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Manage Inventory
              .progress
                .progress-bar(style='width: 100%; background: #3c8dbc;')

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-purchase' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/item-stock.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") ITEM PURCHASE
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Supply Chain Orders
              .progress
                .progress-bar(style='width: 100%; background: #00a65a;')           

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-stock' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/item-purchase.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") STOCK & INVENTORY
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Warehouse Control
              .progress
                .progress-bar(style='width: 100%; background: #f39c12;')

    .row
      //- Row 2: Sales & Documentation Modules
      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-quotation' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/quotationdashboard.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") QUOTATIONS
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Sales & Estimations
              .progress
                .progress-bar(style='width: 100%; background: #00a65a;')

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-challan' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/delivery.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") CHALLAN
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Dispatch & Logistics
              .progress
                .progress-bar(style='width: 100%; background: #00c0ef;')

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-invoice' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/invocie.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") INVOICE
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Billing Settlements
              .progress
                .progress-bar(style='width: 100%; background: #dd4b39;')          

    .row
      //- Row 3: Configurations & Management (Perfectly balances grid architecture)
      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        a(href='/rms/rms-terms-and-conditions' style='text-decoration:none;')
          .info-box.neon-box
            span.info-box-icon(style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);")
              img(src='/dist/img/terms-policy.svg' style='width: 40px; filter: invert(1);')
            .info-box-content
              span.info-box-text(style="color: #2c3e50; font-size: 16px; font-weight: 700;") TERMS & CONDITIONS
              span.info-box-number(style="font-size: 12px; font-weight: 400; color: #7f8c8d;") Policy Documents
              .progress
                .progress-bar(style='width: 100%; background: #605ca8;')                                                                   

      .col-lg-4.col-md-6.col-sm-6.col-xs-12
        .info-box.neon-box(style="opacity: 0.6; border: 1px dashed #bbb;")
          span.info-box-icon(style="background: #f4f4f4;")
            i.fa.fa-plus(style="color: #bbb;")
          .info-box-content
            span.info-box-text(style="color: #bbb; font-weight: 700;") NEW MODULE
            span.info-box-number(style="color: #ccc; font-weight: 400; font-size: 12px;") Coming Soon
            .progress
              .progress-bar(style='width: 0%; background: #ccc;')