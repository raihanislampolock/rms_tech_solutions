script.
  document.addEventListener("DOMContentLoaded", function() {
    // Force body to have collapse classes on page load
    document.body.classList.add('sidebar-mini', 'sidebar-collapse');
    
    // If AdminLTE's window plugin tries to expand it, this stops it
    if (window.jQuery && $.AdminLTE && $.AdminLTE.pushMenu) {
      // Ensures the framework reads the layout state as collapsed
      $('body').addClass('sidebar-collapse');
    }
  });